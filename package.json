{
  "name": "stc-c251-workbench",
  "displayName": "STC C251 Workbench",
  "description": "STC32/C251：导入 Keil 工程、编译、HEX 检查与独立串口烧录。",
  "version": "0.1.9",
  "publisher": "stc-workbench-local",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/blueyeswhitedragon/stc-c251-workbench.git" },
  "homepage": "https://github.com/blueyeswhitedragon/stc-c251-workbench#readme",
  "bugs": { "url": "https://github.com/blueyeswhitedragon/stc-c251-workbench/issues" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other", "Programming Languages"],
  "keywords": ["STC32", "C251", "Keil", "CH340"],
  "main": "./dist/extension.js",
  "activationEvents": ["onView:stcWorkbench.home"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "调用本地编译器和串口前必须信任工作区。" },
    "virtualWorkspaces": { "supported": false }
  },
  "scripts": {
    "compile": "esbuild src/extension.js --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.js",
    "test": "node --test test/core.test.js test/process.test.js test/identify-state.test.js test/identify-workflow.test.js test/toolchain.test.js",
    "vscode:prepublish": "npm run compile && node scripts/licenses.js",
    "package": "node scripts/package.js"
  },
  "dependencies": { "fast-xml-parser": "5.11.2", "iconv-lite": "0.7.2" },
  "devDependencies": { "@vscode/vsce": "3.7.1", "esbuild": "0.25.12" },
  "contributes": {
    "commands": [
      { "command": "stcWorkbench.importProject", "title": "STC: 导入 Keil 工程", "icon": "$(folder-opened)" },
      { "command": "stcWorkbench.selectTarget", "title": "STC: 选择 Target" },
      { "command": "stcWorkbench.build", "title": "STC: Build 编译", "icon": "$(tools)" },
      { "command": "stcWorkbench.rebuild", "title": "STC: Rebuild 全部重新编译" },
      { "command": "stcWorkbench.selectPort", "title": "STC: 选择串口" },
      { "command": "stcWorkbench.monitorSerial", "title": "STC: 串口监视器", "icon": "$(terminal)" },
      { "command": "stcWorkbench.identify", "title": "STC: 识别芯片（只读）", "icon": "$(circuit-board)" },
      { "command": "stcWorkbench.showDeviceStatus", "title": "STC: 查看只读芯片状态" },
      { "command": "stcWorkbench.checkHex", "title": "STC: 校验 HEX 文件" },
      { "command": "stcWorkbench.previewHexBlocks", "title": "STC: 预览 HEX 分块（离线）" },
      { "command": "stcWorkbench.simulateFlash", "title": "STC: 模拟烧录流程（离线）" },
      { "command": "stcWorkbench.flashSafety", "title": "STC: 烧录前安全检查" },
      { "command": "stcWorkbench.flash", "title": "STC: 直接烧录到开发板", "icon": "$(rocket)" },
      { "command": "stcWorkbench.openOfficialIsp", "title": "STC: 打开官方 STC-ISP（手动下载）" },
      { "command": "stcWorkbench.setupPython", "title": "STC: 配置芯片识别环境" },
      { "command": "stcWorkbench.configureKeil", "title": "STC: 设置 Keil 路径" },
      { "command": "stcWorkbench.detectKeil", "title": "STC: 自动检测 Keil 工具链", "icon": "$(search)" },
      { "command": "stcWorkbench.cancel", "title": "STC: 取消当前操作", "icon": "$(debug-stop)" },
      { "command": "stcWorkbench.showOutput", "title": "STC: 显示日志" },
      { "command": "stcWorkbench.settings", "title": "STC: 打开插件设置", "icon": "$(gear)" }
    ],
    "viewsContainers": { "activitybar": [{ "id": "stcWorkbench", "title": "STC", "icon": "media/chip.svg" }] },
    "views": { "stcWorkbench": [{ "id": "stcWorkbench.home", "name": "STC C251 工作台" }] },
    "menus": { "view/title": [
      { "command": "stcWorkbench.importProject", "when": "view == stcWorkbench.home", "group": "navigation" },
      { "command": "stcWorkbench.cancel", "when": "view == stcWorkbench.home && stcWorkbench.busy", "group": "navigation" },
      { "command": "stcWorkbench.settings", "when": "view == stcWorkbench.home", "group": "navigation" }
    ] },
    "configuration": {
      "title": "STC C251 Workbench",
      "properties": {
        "stcWorkbench.keilPath": { "type": "string", "default": "", "scope": "machine", "description": "UV4.exe 的完整路径。留空时自动检查常见 Keil/STC 安装目录；不会修改 PATH。" },
        "stcWorkbench.pythonPath": { "type": "string", "default": "python", "scope": "machine", "description": "创建独立识别环境使用的 Python 3.10+ 可执行文件。" },
        "stcWorkbench.probePythonPath": { "type": "string", "default": "", "scope": "machine", "description": "可选：已安装 pyserial 和 tqdm 的 Python；留空则使用插件创建的独立环境。" },
        "stcWorkbench.probeTimeout": { "type": "integer", "default": 180, "minimum": 10, "maximum": 300, "description": "等待 RES 的秒数。" },
        "stcWorkbench.eraseTimeout": { "type": "integer", "default": 30, "minimum": 5, "maximum": 120, "description": "代码区擦除响应超时秒数；不会自动重发擦除，超时后代码区状态未知。" },
        "stcWorkbench.buildTimeout": { "type": "integer", "default": 300, "minimum": 30, "maximum": 1800, "description": "编译超时秒数。" },
        "stcWorkbench.monitorBaud": { "type": "integer", "default": 115200, "enum": [1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200], "description": "串口监视器波特率。" },
        "stcWorkbench.logEncoding": { "type": "string", "enum": ["auto", "utf8", "gbk"], "default": "auto", "description": "Keil 日志编码。auto 优先 UTF-8，遇无效字节时使用 GBK。" },
        "stcWorkbench.allowEepromErase": { "type": "boolean", "default": false, "description": "保留设置：独立烧录当前始终不擦除用户 EEPROM。" },
        "stcWorkbench.allowHardwareOptions": { "type": "boolean", "default": false, "description": "保留设置：独立烧录当前始终不修改硬件选项。" }
        ,"stcWorkbench.officialIspPath": { "type": "string", "default": "", "scope": "machine", "description": "官方 STC-ISP 可执行文件路径。插件只负责启动，不会自动传参或点击下载。" }
      }
    }
  }
}
